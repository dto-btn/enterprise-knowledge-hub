# logging
LOGGING_CONFIG_FILE=config/logging.yaml #if empty will use config/default-logging.yaml.

# Queue
RABBITMQ_URL=amqp://guest:guest@rabbitmq-ekh:5672/

# PG
POSTGRES_USER=admin
POSTGRES_PASSWORD=<pwd>
POSTGRES_HOST=postgres-ekh
POSTGRES_DB=rag

# PG readonly
#POSTGRES_USER=readonly_user
#POSTGRES_PASSWORD=readonly

# PG Admin
PGADMIN_DEFAULT_EMAIL=<some@email.com>
PGADMIN_DEFAULT_PASSWORD=admin

# Embedding model — shared by all knowledge sources (Wikipedia, TBS policies, etc.)
# EMBEDDING_DIMENSIONS     : vector size to truncate to; must match the VectorField dimensions in the DB tables
# EMBEDDING_MODEL_BACKEND  : informational only (SENTENCE_TRANSFORMER)
# EMBEDDING_MODEL_CLEANUP  : flush GPU cache after each embed() call
# EMBEDDING_MODEL_BATCH_SIZE: number of chunks encoded in one forward pass
# EMBEDDING_MODEL_MAX_LENGTH: token limit per chunk
# EMBEDDING_MODEL_DTYPE    : float16 (default, GPU) or float32 (CPU / MPS stability)
# EMBEDDING_IS_RNG_MODE    : use fake random embeddings (pipeline testing only)
# EMBEDDING_RNG_SEED       : global seed for the RNG embedder
EMBEDDING_DIMENSIONS=512
EMBEDDING_MODEL_BACKEND=SENTENCE_TRANSFORMER
EMBEDDING_MODEL_CLEANUP=False
EMBEDDING_MODEL_BATCH_SIZE=32
EMBEDDING_MODEL_MAX_LENGTH=4096
EMBEDDING_MODEL_DTYPE=float16 # Options: float16, float32
EMBEDDING_IS_RNG_MODE=False
EMBEDDING_RNG_SEED=17

# Per-source ingest pipeline batch sizes (independent of the embedding model)
WIKIPEDIA_PROCESS_BATCH_SIZE=256 # defaults to 256, amount of items pulled out of ingest queue for tokenization
PROCESSING_BATCH_AVERAGE_INTERVAL=10000


# Sentence Transformer specific configs
SENTENCE_TRANSFORMER_IS_CPU=False
# for this parameter if you use a downloaded model you can do it easily this way: 
# uv tool install hf
# hf download Qwen/Qwen3-Embedding-0.6B
# then use that path for the model name, e.g. /home/user/.cache/huggingface/hub/models--Qwen--Qwen3-Embedding-0.6B/snapshots/97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
SENTENCE_TRANSFORMER_MODEL_NAME="Qwen/Qwen3-Embedding-0.6B"
FLASH_ATTENTION_DISABLED=False # Set to True to disable flash_attention_2 even when flash-attn is available

DB_SKIP_STORE=False # Set to True to skip storing processed data in the database, useful for testing and debugging

PYTORCH_ALLOC_CONF="max_split_size_mb:256,garbage_collection_threshold:0.6,expandable_segments:False"
PYTORCH_CUDA_GPU_CAP=0.8

# would extract files while reading bz2 file, be careful with disk space...
DEBUG_EXTRACTION=True

# Depending on the network, ssl issues may occur on a website request, paste the apropriate path to the SSL_CERT_FILE
# or leave blank to disable SSL verification if not needed
ENABLE_SSL_VERIFICATION=

SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# Flags to enable or disable crucial processes in the knowledge base service.
SVC_KB_ENABLE_INGESTION=True # defaults to True
SVC_KB_ENABLE_PROCESSING=True # defaults to True
SVC_KB_ENABLE_STORING=True # defaults to True
SVC_KB_PROGRESS_METRICS_ENABLED=False # defaults to False; updates metadata on phase start rows while running
SVC_KB_PROGRESS_METRICS_UPDATE_MODE=True # defaults to True (update existing rows on update); set False to insert new rows on update
SVC_KB_PROGRESS_UPDATE_EVERY_N_ITEMS=500 # defaults to 500; update progress after this many newly completed items
SVC_KB_PROGRESS_UPDATE_EVERY_SECONDS=2.0 # defaults to 2.0; update progress at least this often
# Metrics are updated if either of the above two conditions are met.

# Cronjob schedule for running the knowledge base scraper, in cron format. Defaults to once a month.
CRON_WIKIPEDIA_SCRAPE="* * 1 * *"

# for future use, cronjob schedule for running the knowledge base processing, in cron format.
# Set to false for development to skip
CRON_WIKIPEDIA_RUN=TRUE

# TBS Policies scraper settings
TBS_FETCH_DELAY=1.0 # polite delay between fetches (seconds)
TBS_REQUEST_TIMEOUT=30 # HTTP request timeout (seconds)